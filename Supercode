import type { NextApiRequest, NextApiResponse } from "next";
export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  const url = process.env.EDGE_BASE_URL || "http://localhost:54321/functions/v1";
  const token = req.headers.authorization || "";
  if (req.method === "GET") {
    const r = await fetch(`${url}/user-preferences`, { headers: { Authorization: token as string } });
    const j = await r.json();
    return res.status(r.ok ? 200 : 400).json(j);
  }
  if (req.method === "POST" || req.method === "PUT") {
    const r = await fetch(`${url}/user-preferences`, { method: req.method, headers: { "Content-Type": "application/json", Authorization: token as string }, body: JSON.stringify(req.body) });
    const j = await r.json();
    return res.status(r.ok ? 200 : 400).json(j);
  }
  return res.status(405).end();
}
