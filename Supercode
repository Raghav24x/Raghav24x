from __future__ import annotations
from dataclasses import dataclass
from typing import List, Dict

@dataclass
class Neighborhood:
  name: str
  safety: float
  walk: float
  metro: bool

@dataclass
class UserPrefs:
  budget: float | None
  districts: List[str]
  weight_safety: float = 0.3
  weight_metro: float = 0.2
  weight_walk: float = 0.5

def score(nei: Neighborhood, prefs: UserPrefs) -> float:
  return nei.safety * prefs.weight_safety + (1.0 if nei.metro else 0.0) * prefs.weight_metro + nei.walk * prefs.weight_walk

def recommend(neighborhoods: List[Neighborhood], prefs: UserPrefs, k: int = 5) -> List[Dict]:
  ranked = sorted(({"name": n.name, "score": round(score(n, prefs), 4)} for n in neighborhoods), key=lambda x: x["score"], reverse=True)
  return ranked[:k]

if __name__ == "__main__":
  demo = [Neighborhood("Centro", 0.7, 0.9, True), Neighborhood("Salamanca", 0.85, 0.8, True), Neighborhood("Lavapiés", 0.6, 0.95, True)]
  prefs = UserPrefs(budget=1200, districts=["Centro", "Salamanca"])
  print(recommend(demo, prefs))
