for select using (true);

create policy if not exists "Neighborhoods: no public inserts"
on public.neighborhoods for insert to public with check (false);
create policy if not exists "Neighborhoods: no public updates"
on public.neighborhoods for update to public using (false) with check (false);
create policy if not exists "Neighborhoods: no public deletes"
on public.neighborhoods for delete to public using (false);

-- Properties: public can view affordable; authenticated can view all; owners manage their rows
drop policy if exists "Public can view affordable properties" on public.properties;
create policy "Public can view affordable properties"
on public.properties for select to anon, authenticated
using (coalesce(price, 1e15) < 500000);

drop policy if exists "Authenticated users can view all properties" on public.properties;
create policy "Authenticated users can view all properties"
on public.properties for select to authenticated using (auth.role() = 'authenticated');

-- Ownership-based writes (requires owner_id)
create policy if not exists "Owners can insert their properties"
on public.properties for insert to authenticated with check (owner_id = auth.uid());
create policy if not exists "Owners can update their properties"
on public.properties for update to authenticated using (owner_id = auth.uid()) with check (owner_id = auth.uid());
create policy if not exists "Owners can delete their properties"
on public.properties for delete to authenticated using (owner_id = auth.uid());

-- User preferences: private per user
create policy if not exists "Users can read own preferences"
on public.user_preferences for select to authenticated using (auth.uid() = user_id);
create policy if not exists "Users can insert own preferences"
on public.user_preferences for insert to authenticated with check (auth.uid() = user_id);
create policy if not exists "Users can update own preferences"
