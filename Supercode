import "jsr:@supabase/functions-js/edge-runtime.d.ts";
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

export default async function handler(req: Request) {
  const url = Deno.env.get("SUPABASE_URL")!;
  const key = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!;
  const supabase = createClient(url, key);

  try {
    const { user_id, max_budget, preferred_districts, limit } = await req.json();
    const { data, error } = await supabase.rpc("match_properties", {
      p_user_id: user_id,
      p_max_budget: max_budget,
      p_preferred_districts: preferred_districts ?? [],
      p_price_weight: 0.5,
      p_district_weight: 0.5,
      p_limit: limit ?? 10,
    });
    if (error) throw error;
    return new Response(JSON.stringify({ ok: true, data }), { headers: { "Content-Type": "application/json" } });
  } catch (e) {
    return new Response(JSON.stringify({ ok: false, error: String(e) }), { status: 400 });
  }
}

Deno.serve(handler);
